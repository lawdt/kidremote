<Window x:Class="KidRemote.Ui.LockOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="KidRemote"
        WindowStyle="None"
        AllowsTransparency="False"
        Background="#0B1020"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual">

    <Grid>
        <Canvas x:Name="Bugs" ClipToBounds="True">
            <TextBlock x:Name="Bug"
                       Text="🐞"
                       FontFamily="Segoe UI Emoji"
                       FontSize="30"
                       Opacity="0.85"
                       RenderTransformOrigin="0.5,0.5">
                <TextBlock.RenderTransform>
                    <RotateTransform x:Name="BugRotation" Angle="0"/>
                </TextBlock.RenderTransform>
            </TextBlock>
        </Canvas>

        <StackPanel x:Name="SchedulePanel"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Margin="56,0,0,0"
                    Visibility="Collapsed">
            <TextBlock x:Name="ScheduleTitle"
                       Text=""
                       FontFamily="Segoe UI"
                       FontSize="18"
                       FontWeight="SemiBold"
                       Foreground="#7E8DB5"
                       Margin="0,0,0,10"/>
            <ItemsControl x:Name="ScheduleList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}"
                                   FontFamily="Consolas, Courier New"
                                   FontSize="16"
                                   Foreground="#9FB0D8"
                                   Margin="0,0,0,4"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>

        <StackPanel x:Name="ChatPanel"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Width="640"
                    Margin="0,0,56,0"
                    Visibility="Collapsed">
            <TextBlock Text="Чат с родителями"
                       FontFamily="Segoe UI"
                       FontSize="18"
                       FontWeight="SemiBold"
                       Foreground="#7E8DB5"
                       Margin="0,0,0,10"/>
            <Border Background="#070B14"
                    BorderBrush="#1E2740"
                    BorderThickness="1"
                    CornerRadius="4"
                    Padding="14,10">
                <StackPanel x:Name="ChatLines"/>
            </Border>

            <TextBox x:Name="ChatInput"
                     FontFamily="Consolas, Courier New"
                     FontSize="15"
                     Margin="0,8,0,0"
                     Padding="10,8"
                     MaxLength="400"
                     Background="#0E1424"
                     Foreground="#F5F7FF"
                     CaretBrush="#00E676"
                     BorderBrush="#2E3C66"
                     BorderThickness="1"
                     KeyDown="OnChatInputKeyDown"/>

            <TextBlock x:Name="ChatHint"
                       Text="напишите родителям и нажмите Enter"
                       FontFamily="Segoe UI"
                       FontSize="13"
                       Foreground="#5D6C94"
                       Margin="2,6,0,0"/>
        </StackPanel>

        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
            <TextBlock x:Name="Clock"
                       Text=""
                       FontFamily="Segoe UI"
                       FontSize="64"
                       FontWeight="Light"
                       Foreground="#5D6C94"
                       Margin="0,0,0,28"
                       HorizontalAlignment="Center"/>

            <TextBlock x:Name="Glyph"
                       Text=""
                       FontSize="72"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,24"/>

            <TextBlock x:Name="Headline"
                       Text=""
                       FontFamily="Segoe UI"
                       FontSize="42"
                       FontWeight="SemiBold"
                       Foreground="#F5F7FF"
                       MaxWidth="900"
                       TextWrapping="Wrap"
                       TextAlignment="Center"
                       HorizontalAlignment="Center"/>

            <TextBlock x:Name="Subtitle"
                       Text=""
                       FontFamily="Segoe UI"
                       FontSize="22"
                       Foreground="#8FA0C8"
                       Margin="0,16,0,0"
                       HorizontalAlignment="Center"/>

            <TextBlock x:Name="HealthNote"
                       Text=""
                       FontFamily="Segoe UI"
                       FontSize="17"
                       Foreground="#C9A227"
                       MaxWidth="760"
                       TextWrapping="Wrap"
                       TextAlignment="Center"
                       Margin="0,32,0,0"
                       Visibility="Collapsed"
                       HorizontalAlignment="Center"/>

        </StackPanel>
    </Grid>
</Window>
