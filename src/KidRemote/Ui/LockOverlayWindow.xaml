<Window x:Class="KidRemote.Ui.LockOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="KidRemote"
        WindowStyle="None"
        AllowsTransparency="False"
        Background="#0B1020"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="LeftColumn" Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition x:Name="RightColumn" Width="Auto"/>
        </Grid.ColumnDefinitions>

        <StackPanel x:Name="SchedulePanel"
                    Grid.Column="0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Margin="56,0,24,0"
                    Visibility="Collapsed">
            <TextBlock x:Name="ScheduleTitle"
                       Text=""
                       FontFamily="Segoe UI"
                       FontSize="24"
                       FontWeight="SemiBold"
                       Foreground="#7E8DB5"
                       Margin="0,0,0,14"/>
            <ItemsControl x:Name="ScheduleList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}"
                                   FontFamily="Consolas, Courier New"
                                   FontSize="21"
                                   Foreground="#9FB0D8"
                                   Margin="0,0,0,7"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>

        <StackPanel x:Name="ChatPanel"
                    Grid.Column="2"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Width="620"
                    Margin="24,0,56,0"
                    Visibility="Collapsed">
            <TextBlock Text="Чат с родителями"
                       FontFamily="Segoe UI"
                       FontSize="18"
                       FontWeight="SemiBold"
                       Foreground="#7E8DB5"
                       Margin="0,0,0,10"/>
            <Border Background="#070B14"
                    BorderBrush="#1E2740"
                    BorderThickness="1"
                    CornerRadius="4"
                    Padding="14,10">
                <ScrollViewer x:Name="ChatScroll"
                              MaxHeight="520"
                              VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="ChatLines"/>
                </ScrollViewer>
            </Border>

            <WrapPanel x:Name="EmojiPanel"
                       Margin="0,8,0,0"
                       Visibility="Collapsed"/>

            <DockPanel Margin="0,8,0,0">
                <Button x:Name="SendButton"
                        DockPanel.Dock="Right"
                        Width="52"
                        Height="40"
                        Margin="8,0,0,0"
                        Background="#1B2440"
                        Foreground="#F5F7FF"
                        BorderBrush="#2E3C66"
                        BorderThickness="1"
                        Cursor="Hand"
                        Focusable="False"
                        Click="OnSendClick">
                    <Path Data="M2,21 L23,12 L2,3 L2,10 L17,12 L2,14 Z"
                          Fill="#7FC5FF"
                          Stretch="Uniform"
                          Width="22"
                          Height="22"/>
                </Button>

                <RichTextBox x:Name="ChatInput"
                             FontFamily="Consolas, Courier New"
                             FontSize="15"
                             MinHeight="40"
                             MaxHeight="120"
                             Padding="8,7"
                             Background="#0E1424"
                             Foreground="#F5F7FF"
                             CaretBrush="#00E676"
                             BorderBrush="#2E3C66"
                             BorderThickness="1"
                             VerticalScrollBarVisibility="Auto"
                             AcceptsReturn="True"
                             PreviewKeyDown="OnChatInputKeyDown"/>
            </DockPanel>

            <DockPanel Margin="2,6,0,0">
                <Button x:Name="EmojiButton"
                        DockPanel.Dock="Right"
                        Width="42"
                        Padding="0,4"
                        Margin="0,0,6,0"
                        Background="#1B2440"
                        Foreground="#DCE4F7"
                        BorderBrush="#2E3C66"
                        BorderThickness="1"
                        Cursor="Hand"
                        Focusable="False"
                        Click="OnEmojiToggle"/>

                <Button x:Name="LayoutButton"
                        DockPanel.Dock="Right"
                        Content="RU"
                        FontFamily="Consolas, Courier New"
                        FontSize="13"
                        FontWeight="Bold"
                        Width="52"
                        Padding="0,4"
                        Background="#1B2440"
                        Foreground="#DCE4F7"
                        BorderBrush="#2E3C66"
                        BorderThickness="1"
                        Cursor="Hand"
                        Focusable="False"
                        Click="OnLayoutClick"/>

                <TextBlock x:Name="ChatHint"
                           Text="напишите родителям и нажмите Enter"
                           FontFamily="Segoe UI"
                           FontSize="13"
                           Foreground="#5D6C94"
                           VerticalAlignment="Center"/>
            </DockPanel>
        </StackPanel>

        <StackPanel x:Name="CenterPanel"
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center">
            <TextBlock x:Name="Clock"
                       Text=""
                       FontFamily="Segoe UI"
                       FontSize="64"
                       FontWeight="Light"
                       Foreground="#5D6C94"
                       Margin="0,0,0,6"
                       HorizontalAlignment="Center"/>

            <TextBlock x:Name="DateLine"
                       Text=""
                       FontFamily="Segoe UI"
                       FontSize="20"
                       Foreground="#46527A"
                       Margin="0,0,0,26"
                       HorizontalAlignment="Center"/>

            <TextBlock x:Name="Glyph"
                       Text=""
                       FontSize="72"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,24"
                       Cursor="Hand"
                       RenderTransformOrigin="0.5,0.5"
                       MouseLeftButtonDown="OnLockClick">
                <TextBlock.RenderTransform>
                    <RotateTransform x:Name="GlyphShake"/>
                </TextBlock.RenderTransform>
            </TextBlock>

            <TextBlock x:Name="Headline"
                       Text=""
                       FontFamily="Segoe UI"
                       FontSize="42"
                       FontWeight="SemiBold"
                       Foreground="#F5F7FF"
                       MaxWidth="620"
                       TextWrapping="Wrap"
                       TextAlignment="Center"
                       HorizontalAlignment="Center"/>

            <TextBlock x:Name="Subtitle"
                       Text=""
                       FontFamily="Segoe UI"
                       FontSize="22"
                       Foreground="#8FA0C8"
                       Margin="0,16,0,0"
                       HorizontalAlignment="Center"/>

            <TextBlock x:Name="HealthNote"
                       Text=""
                       FontFamily="Segoe UI"
                       FontSize="17"
                       Foreground="#C9A227"
                       MaxWidth="560"
                       TextWrapping="Wrap"
                       TextAlignment="Center"
                       Margin="0,32,0,0"
                       Visibility="Collapsed"
                       HorizontalAlignment="Center"/>

        </StackPanel>

        <!-- Едва заметный шум поверх неба: без него плавный градиент идёт ступенями. -->
        <Rectangle x:Name="SkyDither"
                   Grid.ColumnSpan="3"
                   Opacity="0.05"
                   IsHitTestVisible="False"/>

        <Canvas x:Name="HomeLayer" Grid.ColumnSpan="3">
            <!-- Домик, куда коровка изредка забирается отсидеться. -->
            <Canvas x:Name="BugHome" Cursor="Hand" MouseLeftButtonDown="OnHomeClick" Width="58" Height="50" Opacity="0.9">
                <Path Data="M3,24 L29,4 L55,24 Z" Fill="#8C4A2F"/>
                <Rectangle Canvas.Left="10" Canvas.Top="23" Width="38" Height="26" Fill="#B9794E"/>
                <Rectangle Canvas.Left="10" Canvas.Top="23" Width="38" Height="3" Fill="#7A4027"/>
                <!-- Дверь сдвинута влево, чтобы справа поместилось окно. -->
                <Path Data="M13,49 L13,36 A8,8 0 0 1 29,36 L29,49 Z" Fill="#2A1A12"/>
                <Rectangle Canvas.Left="20" Canvas.Top="42" Width="2" Height="2" Fill="#C9A227" RadiusX="1" RadiusY="1"/>

                <!-- Окно: рама, стекло и переплёт крестом. -->
                <Rectangle Canvas.Left="33" Canvas.Top="29" Width="14" Height="14" Fill="#7A4027"/>
                <Rectangle x:Name="HomeWindow" Canvas.Left="35" Canvas.Top="31" Width="10" Height="10" Fill="#3A2718"/>
                <Rectangle Canvas.Left="39.4" Canvas.Top="31" Width="1.2" Height="10" Fill="#7A4027"/>
                <Rectangle Canvas.Left="35" Canvas.Top="35.4" Width="10" Height="1.2" Fill="#7A4027"/>
                <Rectangle Canvas.Left="32" Canvas.Top="43" Width="16" Height="1.6" Fill="#6B4A21"/>
            </Canvas>


            <Border x:Name="SpeechBubble"
                    Background="#F5F7FF"
                    CornerRadius="10"
                    Padding="12,8"
                    Visibility="Collapsed">
                <TextBlock x:Name="SpeechText"
                           Text=""
                           FontFamily="Segoe UI"
                           FontSize="15"
                           Foreground="#111626"
                           MaxWidth="240"
                           TextWrapping="Wrap"/>
            </Border>
        </Canvas>

        <Canvas x:Name="Bugs" ClipToBounds="True" Grid.ColumnSpan="3">
            <!-- Коровка нарисована фигурами: эмодзи в WPF выходит чёрно-белым. -->
            <Canvas x:Name="Bug" Width="30" Height="34" RenderTransformOrigin="0.5,0.5"
                    Background="Transparent" Cursor="Hand" MouseLeftButtonDown="OnBugGrab">
                <Canvas.RenderTransform>
                    <RotateTransform x:Name="BugRotation" Angle="0"/>
                </Canvas.RenderTransform>

                <Ellipse Canvas.Left="9" Canvas.Top="0" Width="12" Height="11" Fill="#15171C"/>
                <Ellipse Canvas.Left="7" Canvas.Top="1" Width="3" Height="3" Fill="#E8ECF7"/>
                <Ellipse Canvas.Left="20" Canvas.Top="1" Width="3" Height="3" Fill="#E8ECF7"/>

                <Rectangle x:Name="LegL1" Canvas.Left="-7" Canvas.Top="12" Width="9" Height="2.6"
                           Fill="#15171C" RadiusX="1" RadiusY="1" RenderTransformOrigin="1,0.5">
                    <Rectangle.RenderTransform><RotateTransform x:Name="LegL1R"/></Rectangle.RenderTransform>
                </Rectangle>
                <Rectangle x:Name="LegL2" Canvas.Left="-8" Canvas.Top="20" Width="10" Height="2.6"
                           Fill="#15171C" RadiusX="1" RadiusY="1" RenderTransformOrigin="1,0.5">
                    <Rectangle.RenderTransform><RotateTransform x:Name="LegL2R"/></Rectangle.RenderTransform>
                </Rectangle>
                <Rectangle x:Name="LegL3" Canvas.Left="-7" Canvas.Top="28" Width="9" Height="2.6"
                           Fill="#15171C" RadiusX="1" RadiusY="1" RenderTransformOrigin="1,0.5">
                    <Rectangle.RenderTransform><RotateTransform x:Name="LegL3R"/></Rectangle.RenderTransform>
                </Rectangle>

                <Rectangle x:Name="LegR1" Canvas.Left="28" Canvas.Top="12" Width="9" Height="2.6"
                           Fill="#15171C" RadiusX="1" RadiusY="1" RenderTransformOrigin="0,0.5">
                    <Rectangle.RenderTransform><RotateTransform x:Name="LegR1R"/></Rectangle.RenderTransform>
                </Rectangle>
                <Rectangle x:Name="LegR2" Canvas.Left="28" Canvas.Top="20" Width="10" Height="2.6"
                           Fill="#15171C" RadiusX="1" RadiusY="1" RenderTransformOrigin="0,0.5">
                    <Rectangle.RenderTransform><RotateTransform x:Name="LegR2R"/></Rectangle.RenderTransform>
                </Rectangle>
                <Rectangle x:Name="LegR3" Canvas.Left="28" Canvas.Top="28" Width="9" Height="2.6"
                           Fill="#15171C" RadiusX="1" RadiusY="1" RenderTransformOrigin="0,0.5">
                    <Rectangle.RenderTransform><RotateTransform x:Name="LegR3R"/></Rectangle.RenderTransform>
                </Rectangle>

                <Ellipse Canvas.Left="1" Canvas.Top="7" Width="28" Height="27"
                         Fill="#D7262F" Stroke="#15171C" StrokeThickness="1.2"/>
                <Rectangle Canvas.Left="14.3" Canvas.Top="8" Width="1.6" Height="25" Fill="#15171C"/>

                <Ellipse Canvas.Left="5" Canvas.Top="13" Width="5" Height="5" Fill="#15171C"/>
                <Ellipse Canvas.Left="20" Canvas.Top="13" Width="5" Height="5" Fill="#15171C"/>
                <Ellipse Canvas.Left="7" Canvas.Top="24" Width="4" Height="4" Fill="#15171C"/>
                <Ellipse Canvas.Left="19" Canvas.Top="24" Width="4" Height="4" Fill="#15171C"/>
            </Canvas>
        </Canvas>
    </Grid>
</Window>
