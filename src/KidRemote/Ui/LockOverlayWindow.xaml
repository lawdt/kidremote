<Window x:Class="KidRemote.Ui.LockOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="KidRemote"
        WindowStyle="None"
        AllowsTransparency="False"
        Background="#0B1020"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual">

    <Grid>
        <Canvas x:Name="Bugs" ClipToBounds="True">
            <TextBlock x:Name="Bug"
                       Text="🪲"
                       FontFamily="Segoe UI Emoji"
                       FontSize="30"
                       Opacity="0.85"
                       RenderTransformOrigin="0.5,0.5">
                <TextBlock.RenderTransform>
                    <RotateTransform x:Name="BugRotation" Angle="0"/>
                </TextBlock.RenderTransform>
            </TextBlock>
        </Canvas>

        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
            <TextBlock x:Name="Clock"
                       Text=""
                       FontFamily="Segoe UI"
                       FontSize="64"
                       FontWeight="Light"
                       Foreground="#5D6C94"
                       Margin="0,0,0,28"
                       HorizontalAlignment="Center"/>

            <TextBlock x:Name="Glyph"
                       Text=""
                       FontSize="72"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,24"/>

            <TextBlock x:Name="Headline"
                       Text=""
                       FontFamily="Segoe UI"
                       FontSize="42"
                       FontWeight="SemiBold"
                       Foreground="#F5F7FF"
                       MaxWidth="900"
                       TextWrapping="Wrap"
                       TextAlignment="Center"
                       HorizontalAlignment="Center"/>

            <TextBlock x:Name="Subtitle"
                       Text=""
                       FontFamily="Segoe UI"
                       FontSize="22"
                       Foreground="#8FA0C8"
                       Margin="0,16,0,0"
                       HorizontalAlignment="Center"/>

            <TextBlock x:Name="HealthNote"
                       Text=""
                       FontFamily="Segoe UI"
                       FontSize="17"
                       Foreground="#C9A227"
                       MaxWidth="760"
                       TextWrapping="Wrap"
                       TextAlignment="Center"
                       Margin="0,32,0,0"
                       Visibility="Collapsed"
                       HorizontalAlignment="Center"/>

            <Button x:Name="MessageButton"
                    Content="✉  Написать родителям"
                    FontFamily="Segoe UI"
                    FontSize="16"
                    Padding="18,10"
                    Margin="0,48,0,0"
                    HorizontalAlignment="Center"
                    Background="#1B2440"
                    Foreground="#F5F7FF"
                    BorderBrush="#2E3C66"
                    BorderThickness="1"
                    Cursor="Hand"
                    Click="OnMessageClick"/>
        </StackPanel>
    </Grid>
</Window>
