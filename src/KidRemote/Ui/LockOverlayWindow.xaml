<Window x:Class="KidRemote.Ui.LockOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="KidRemote"
        WindowStyle="None"
        AllowsTransparency="False"
        Background="#0B1020"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual">

    <Grid>
        <Canvas x:Name="Bugs" ClipToBounds="True">
            <!-- Коровка нарисована фигурами: эмодзи в WPF выходит чёрно-белым. -->
            <Canvas x:Name="Bug" Width="30" Height="34" RenderTransformOrigin="0.5,0.5">
                <Canvas.RenderTransform>
                    <RotateTransform x:Name="BugRotation" Angle="0"/>
                </Canvas.RenderTransform>

                <Ellipse Canvas.Left="9" Canvas.Top="0" Width="12" Height="11" Fill="#15171C"/>
                <Ellipse Canvas.Left="7" Canvas.Top="1" Width="3" Height="3" Fill="#E8ECF7"/>
                <Ellipse Canvas.Left="20" Canvas.Top="1" Width="3" Height="3" Fill="#E8ECF7"/>

                <Ellipse Canvas.Left="1" Canvas.Top="7" Width="28" Height="27"
                         Fill="#D7262F" Stroke="#15171C" StrokeThickness="1.2"/>
                <Rectangle Canvas.Left="14.3" Canvas.Top="8" Width="1.6" Height="25" Fill="#15171C"/>

                <Ellipse Canvas.Left="5" Canvas.Top="13" Width="5" Height="5" Fill="#15171C"/>
                <Ellipse Canvas.Left="20" Canvas.Top="13" Width="5" Height="5" Fill="#15171C"/>
                <Ellipse Canvas.Left="7" Canvas.Top="24" Width="4" Height="4" Fill="#15171C"/>
                <Ellipse Canvas.Left="19" Canvas.Top="24" Width="4" Height="4" Fill="#15171C"/>
            </Canvas>
        </Canvas>

        <StackPanel x:Name="SchedulePanel"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Margin="56,0,0,0"
                    Visibility="Collapsed">
            <TextBlock x:Name="ScheduleTitle"
                       Text=""
                       FontFamily="Segoe UI"
                       FontSize="18"
                       FontWeight="SemiBold"
                       Foreground="#7E8DB5"
                       Margin="0,0,0,10"/>
            <ItemsControl x:Name="ScheduleList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}"
                                   FontFamily="Consolas, Courier New"
                                   FontSize="16"
                                   Foreground="#9FB0D8"
                                   Margin="0,0,0,4"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>

        <StackPanel x:Name="ChatPanel"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Width="640"
                    Margin="0,0,56,0"
                    Visibility="Collapsed">
            <TextBlock Text="Чат с родителями"
                       FontFamily="Segoe UI"
                       FontSize="18"
                       FontWeight="SemiBold"
                       Foreground="#7E8DB5"
                       Margin="0,0,0,10"/>
            <Border Background="#070B14"
                    BorderBrush="#1E2740"
                    BorderThickness="1"
                    CornerRadius="4"
                    Padding="14,10">
                <ScrollViewer x:Name="ChatScroll"
                              MaxHeight="340"
                              VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="ChatLines"/>
                </ScrollViewer>
            </Border>

            <TextBox x:Name="ChatInput"
                     FontFamily="Consolas, Courier New"
                     FontSize="15"
                     Margin="0,8,0,0"
                     Padding="10,8"
                     MaxLength="400"
                     Background="#0E1424"
                     Foreground="#F5F7FF"
                     CaretBrush="#00E676"
                     BorderBrush="#2E3C66"
                     BorderThickness="1"
                     KeyDown="OnChatInputKeyDown"/>

            <DockPanel Margin="2,6,0,0">
                <Button x:Name="LayoutButton"
                        DockPanel.Dock="Right"
                        Content="RU"
                        FontFamily="Consolas, Courier New"
                        FontSize="13"
                        FontWeight="Bold"
                        Width="52"
                        Padding="0,4"
                        Background="#1B2440"
                        Foreground="#DCE4F7"
                        BorderBrush="#2E3C66"
                        BorderThickness="1"
                        Cursor="Hand"
                        Focusable="False"
                        Click="OnLayoutClick"/>

                <TextBlock x:Name="ChatHint"
                           Text="напишите родителям и нажмите Enter"
                           FontFamily="Segoe UI"
                           FontSize="13"
                           Foreground="#5D6C94"
                           VerticalAlignment="Center"/>
            </DockPanel>
        </StackPanel>

        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
            <TextBlock x:Name="Clock"
                       Text=""
                       FontFamily="Segoe UI"
                       FontSize="64"
                       FontWeight="Light"
                       Foreground="#5D6C94"
                       Margin="0,0,0,28"
                       HorizontalAlignment="Center"/>

            <TextBlock x:Name="Glyph"
                       Text=""
                       FontSize="72"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,24"/>

            <TextBlock x:Name="Headline"
                       Text=""
                       FontFamily="Segoe UI"
                       FontSize="42"
                       FontWeight="SemiBold"
                       Foreground="#F5F7FF"
                       MaxWidth="900"
                       TextWrapping="Wrap"
                       TextAlignment="Center"
                       HorizontalAlignment="Center"/>

            <TextBlock x:Name="Subtitle"
                       Text=""
                       FontFamily="Segoe UI"
                       FontSize="22"
                       Foreground="#8FA0C8"
                       Margin="0,16,0,0"
                       HorizontalAlignment="Center"/>

            <TextBlock x:Name="HealthNote"
                       Text=""
                       FontFamily="Segoe UI"
                       FontSize="17"
                       Foreground="#C9A227"
                       MaxWidth="760"
                       TextWrapping="Wrap"
                       TextAlignment="Center"
                       Margin="0,32,0,0"
                       Visibility="Collapsed"
                       HorizontalAlignment="Center"/>

        </StackPanel>
    </Grid>
</Window>
