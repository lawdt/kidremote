<Window x:Class="KidRemote.Ui.LockOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="KidRemote"
        WindowStyle="None"
        AllowsTransparency="False"
        Background="#0B1020"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        Cursor="None">

    <Grid>
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
            <TextBlock x:Name="Glyph"
                       Text=""
                       FontSize="72"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,24"/>

            <TextBlock x:Name="Headline"
                       Text=""
                       FontFamily="Segoe UI"
                       FontSize="42"
                       FontWeight="SemiBold"
                       Foreground="#F5F7FF"
                       MaxWidth="900"
                       TextWrapping="Wrap"
                       TextAlignment="Center"
                       HorizontalAlignment="Center"/>

            <TextBlock x:Name="Subtitle"
                       Text=""
                       FontFamily="Segoe UI"
                       FontSize="22"
                       Foreground="#8FA0C8"
                       Margin="0,16,0,0"
                       HorizontalAlignment="Center"/>
        </StackPanel>
    </Grid>
</Window>
